# Firebase 設定 (https://console.firebase.google.com でプロジェクトを作成し取得)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# LINE Messaging API (https://developers.line.biz/)
VITE_LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
VITE_LINE_GROUP_ID=your-line-group-id-or-user-id

# Microsoft Teams Incoming Webhook URL
VITE_TEAMS_WEBHOOK_URL=https://xxx.webhook.office.com/webhookb2/...
